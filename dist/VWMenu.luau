        local id = self._nextId
        self._pending[id] = { Action=action, Time=os.clock(), Callback=callback }
        local ok, err = pcall(function()
            self._request:FireServer({Id=id,Action=action,Payload=payload or {},Session=self.Session})
        end)
        if not ok then
