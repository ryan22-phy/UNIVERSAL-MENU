			TextColor3 = COLORS.Text,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			Position = position,
			Size = size,
		}
		for key, item in pairs(options or {}) do properties[key] = item end
