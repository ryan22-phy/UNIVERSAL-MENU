        {"DroppedItem","DroppedItems"},{"Loot","Loot"},{"WeaponPickup","Weapons"},
        {"ToolPickup","Tools"},{"TestCollectible","Collectibles"},{"Objective","Objectives"},
        {"VWTestItem","TestObjects"},{"TestObject","TestObjects"},
